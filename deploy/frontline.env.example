# Copy to /etc/frontline/frontline.env (owner root, mode 600) and fill in. Never commit the real one.
NODE_ENV=production
HOST=127.0.0.1
PORT=4000
# Generate with: openssl rand -hex 32
JWT_SECRET=
ADMIN=false
CORS_ORIGIN=https://play.example.com
# Caddy is one hop in front. With Cloudflare in front of Caddy as well, this becomes 2.
TRUST_PROXY=1
DATABASE_PATH=/var/lib/frontline/frontline.sqlite
BACKUP_DIR=/var/lib/frontline/backups
# A second disk, or a folder a sync client carries off the machine. Empty disables the mirror.
BACKUP_MIRROR_DIR=/mnt/backup/frontline
MAX_CONNECTIONS=4096
