# Copy to .env and adjust. All values shown are the defaults.
PORT=4000
HOST=0.0.0.0
DATABASE_PATH=./frontline.sqlite
JWT_SECRET=dev-secret-change-me
CORS_ORIGIN=http://localhost:5173

# Sandbox switch. Only the literal `true` turns it on — `1`, `yes` and `TRUE` all leave it off, so
# it cannot be enabled by a near-miss. On every boot it raises the seeded dev account to the
# end-game state (see src/seed/sandbox.ts) so the whole game can be looked at without playing to it.
# Turning it back off leaves the account where it is rather than rolling progress back.
UNLOCKED=false

# Admin / testing mode, and it is ON unless this says the literal `false` — the opposite spelling of
# UNLOCKED above, deliberately. Every clock in the game becomes 5 seconds and nothing is charged,
# while every screen still shows the real price and the real duration; the HUD carries a badge and
# the bench at /game/admin appears. Gates are untouched: locked is still locked, a full queue is
# still full, supply is still supply. Set this to `false` for a build that charges.
ADMIN=true

# Point-in-time snapshots, taken with VACUUM INTO every ten minutes. The newest 24 are kept.
# Restoring one is three commands and no replay — see docs/RECOVERY.md.
BACKUP_DIR=./backups
BACKUPS=true
